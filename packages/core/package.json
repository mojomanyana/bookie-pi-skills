{
  "name": "@bookie/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b --force && node scripts/copy-schemas.mjs",
    "build:force": "tsc -b --force && node scripts/copy-schemas.mjs",
    "benchmark:export": "npm run build && node scripts/benchmark-canonical-export.mjs",
    "benchmark:query": "npm run build && node scripts/benchmark-filesystem-query.mjs",
    "benchmark:vault": "npm run build && node scripts/benchmark-vault-validation.mjs",
    "prepack": "npm run build:force",
    "test": "npm run build && npm run test:built",
    "typecheck": "tsc -b --pretty false",
    "test:built": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "yaml": "^2.9.0"
  }
}
