{
  "name": "@bookie/pi-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -b --force && node ../../packages/core/scripts/copy-schemas.mjs",
    "prepack": "npm run build:force",
    "test": "npm run build && npm run test:built",
    "typecheck": "tsc -b --pretty false",
    "build:force": "tsc -b --force && node ../../packages/core/scripts/copy-schemas.mjs",
    "test:built": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@bookie/core": "0.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
