{
  "name": "pi-bookie",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -b --force && node ../../packages/core/scripts/copy-schemas.mjs",
    "prepack": "npm run build:force",
    "test": "npm run build && npm run test:built",
    "typecheck": "tsc -b --pretty false",
    "build:force": "tsc -b --force && node ../../packages/core/scripts/copy-schemas.mjs",
    "test:built": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "pi-bookie-core": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
