{
  "name": "bookie-pi-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, OKF-compatible project ledger and Pi tooling.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-extension/src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -b --force && node packages/core/scripts/copy-schemas.mjs",
    "prepare": "npm run build --workspace @bookie/core",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,json,yaml,yml}\"",
    "lint": "eslint .",
    "test": "npm run build && npm run test:repo && npm run test:built --workspaces --if-present",
    "test:repo": "node --test test/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "dependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.7.0",
    "typescript-eslint": "^8.48.0",
    "yaml": "^2.9.0"
  },
  "packageManager": "npm@11.9.0"
}
