{
  "name": "@bookie/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b --force && node ../../packages/core/scripts/copy-schemas.mjs",
    "build:force": "tsc -b --force && node ../../packages/core/scripts/copy-schemas.mjs",
    "test": "npm run build && npm run test:built",
    "test:redis": "npm run build && node --test test/redis/*.test.mjs",
    "test:deployment": "npm run build && node --test test/deployment/*.test.mjs",
    "test:runtime": "node scripts/qualify-runtime.mjs",
    "typecheck": "tsc -b --pretty false",
    "test:built": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@bookie/core": "0.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.4",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  }
}
