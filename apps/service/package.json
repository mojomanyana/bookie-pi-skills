{
  "name": "@bookie/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:force --workspace @bookie/core && tsc -b --force",
    "build:force": "npm run build:force --workspace @bookie/core && tsc -b --force",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:redis": "npm run build && node --test test/redis/*.test.mjs",
    "test:deployment": "npm run build && node --test test/deployment/*.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@bookie/core": "0.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.4",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  }
}
